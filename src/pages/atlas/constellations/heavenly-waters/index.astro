const articleData = {
  headline: 'The Heavenly Waters: Constellations of the Cosmic Sea',
  description: 'Guide to the Heavenly Waters family of constellations — Eridanus, Carina, Puppis, Vela, Pyxis, Columba, Delphinus, Equuleus and Piscis Austrinus. Water-themed patterns and the great ship Argo Navis.',
  datePublished: '2026-07-24',
  dateModified: '2026-07-24',
