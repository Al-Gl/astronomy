const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Cosmic Atlas', url: '/atlas/' },
  { name: 'Constellations', url: '/atlas/constellations/' },
  { name: 'Orion Family', url: '/atlas/constellations/orion-family/' }
];

const articleData = {
  headline: 'The Orion Family: The Hunter and His Companions',
  description: 'Guide to the Orion family of constellations — Orion, Canis Major, Canis Minor, Monoceros and Lepus. The showpiece patterns of the winter sky, their brightest stars, and the Orion Nebula.',
  datePublished: '2026-07-24',
  dateModified: '2026-07-24',
  author: 'The Astronomy Space',
  image: '/images/Hero_orion-family.jpg',
  keywords: ['Orion family', 'Orion constellation', 'Canis Major', 'Sirius', 'Betelgeuse', 'Rigel', 'Orion Nebula', 'winter constellations', 'Lepus', 'Monoceros']
};

const faqData = [
  {
    question: 'What constellations make up the Orion family?',
    answer: 'The Orion family consists of five constellations clustered in the winter sky: Orion (the Hunter), Canis Major (the Great Dog), Canis Minor (the Lesser Dog), Monoceros (the Unicorn), and Lepus (the Hare). They are grouped together both because they lie near one another and because most share the mythological theme of Orion the hunter, his two hunting dogs, and the hare they pursue.'
  },
  {
    question: 'Why is Orion so easy to recognize?',
    answer: 'Orion is dominated by seven bright stars in a distinctive figure, most notably the three evenly spaced, similarly bright stars of Orion’s Belt — a pattern that appears nowhere else in the sky. Flanking the belt are two brilliant stars of contrasting color: red-orange Betelgeuse at the hunter’s shoulder and blue-white Rigel at his foot. This combination of bright, colorful stars and the unmistakable belt makes Orion the most recognizable constellation in the night sky.'
  },
  {
    question: 'What is the Orion Nebula?',
    answer: 'The Orion Nebula (Messier 42) is a vast cloud of glowing gas and dust about 1,340 light-years away, hanging in Orion’s "sword" below the belt. It is visible to the naked eye as a fuzzy patch and is one of the closest and most studied stellar nurseries, where new stars are actively being born. Through binoculars or a telescope it reveals intricate wisps of nebulosity surrounding the Trapezium, a compact cluster of hot young stars whose radiation makes the surrounding gas glow.'
  },
  {
    question: 'What is the brightest star in the Orion family?',
    answer: 'Sirius, in Canis Major, is the brightest star in the entire night sky at magnitude −1.46. Often called the "Dog Star," it lies just 8.6 light-years away, making it one of our nearest stellar neighbours. Its brilliance is a combination of genuine luminosity and proximity. You can find Sirius easily by following the line of Orion’s Belt down and to the left (in the northern hemisphere).'
  },
  {
    question: 'When is the best time to see the Orion family?',
    answer: 'The Orion family dominates the winter evening sky in the northern hemisphere, best seen from December through March when the constellations ride high after dark. In the southern hemisphere they appear during summer, though "upside down" compared with the northern view. Around June the group lies too close to the Sun to observe, disappearing into the daytime sky for a couple of months.'
  },
  {
    question: 'Is Betelgeuse going to explode?',
    answer: 'Betelgeuse is a red supergiant nearing the end of its life, and it will eventually explode as a supernova. However, "eventually" on stellar timescales could mean any time within roughly the next 100,000 years — likely not in our lifetimes. When it does, it will briefly shine as bright as the crescent Moon and be visible in daylight, before fading over months. In 2019–2020 Betelgeuse dimmed dramatically, but this turned out to be caused by an ejected cloud of dust, not an imminent explosion.'
  }
];
