              <circle cx="12" cy="5" r="1" fill="currentColor"/>
              <circle cx="18" cy="7" r="1" fill="currentColor"/>
              <circle cx="9" cy="12" r="1" fill="currentColor"/>
              <circle cx="15" cy="13" r="1" fill="currentColor"/>
