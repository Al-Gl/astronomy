const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Cosmic Atlas', url: '/atlas/' },
  { name: 'Constellations', url: '/atlas/constellations/' },
  { name: 'Circumpolar Constellations', url: '/atlas/constellations/circumpolar/' }
];

const articleData = {
  headline: 'Circumpolar Constellations: The Stars That Never Set',
  description: 'Guide to circumpolar constellations — the star patterns that circle the celestial poles and stay visible all night, all year. Learn the northern and southern circumpolar groups and how latitude decides what you see.',
  datePublished: '2026-07-24',
  dateModified: '2026-07-24',
  author: 'The Astronomy Space',
  image: '/images/Hero_circumpolar.jpg',
  keywords: ['circumpolar constellations', 'Ursa Major', 'Cassiopeia', 'Polaris', 'Southern Cross', 'celestial pole', 'star trails', 'latitude']
};

const faqData = [
  {
    question: 'What does circumpolar mean?',
    answer: 'A circumpolar constellation is one that never sets below the horizon as seen from a given location. Instead of rising and setting, it appears to circle the celestial pole throughout the night, remaining visible every clear night of the year. The word literally means "around the pole." Which constellations are circumpolar depends entirely on your latitude.'
  },
  {
    question: 'Why are some constellations circumpolar and others not?',
    answer: 'It comes down to how close a star lies to the celestial pole relative to your latitude. A star is circumpolar from your location if its angular distance from the pole is less than your latitude. From 50°N, for example, any star within 50 degrees of the north celestial pole never dips below the horizon. Stars farther from the pole rise and set, and stars in the opposite hemisphere never rise at all.'
  },
  {
    question: 'Which constellations are circumpolar from the northern hemisphere?',
    answer: 'From mid-northern latitudes (around 40–50°N), the main circumpolar constellations are Ursa Major (the Great Bear, containing the Big Dipper), Ursa Minor (the Little Bear, containing Polaris), Cassiopeia, Cepheus, Draco, and Camelopardalis. These six patterns wheel around Polaris and are visible on any clear night of the year, though their orientation changes with the seasons and the hour.'
  },
  {
    question: 'Is there a South Star like Polaris?',
    answer: 'No bright star marks the south celestial pole the way Polaris marks the north. The nearest naked-eye star to the southern pole is Sigma Octantis in the constellation Octans, but it is so faint (magnitude 5.4) that it is nearly useless for navigation. Instead, southern-hemisphere observers use the Southern Cross (Crux) as a pointer: extending the long axis of the cross about 4.5 times its length locates the pole.'
  },
  {
    question: 'Does the number of circumpolar constellations change with location?',
    answer: 'Yes, dramatically. At the North Pole (90°N), the entire visible sky is circumpolar — every star simply circles overhead and none ever rise or set. At the equator (0° latitude), no stars are circumpolar at all; every constellation rises and sets, and over the year you can see the whole sky. Between these extremes, the higher your latitude, the larger the cap of circumpolar sky around your pole.'
  },
  {
    question: 'What causes star trails to circle the pole?',
    answer: 'Star trails are the apparent arcs traced by stars in a long-exposure photograph. They are caused by Earth’s rotation on its axis. Because the celestial poles lie directly above Earth’s geographic poles, stars appear to pivot around them. A star exactly at the pole would barely move, while stars farther away sweep out longer arcs. Pointing a camera at Polaris and taking a long exposure produces the classic set of concentric circular trails.'
  }
];
---

<MainLayout
