];

const articleData = {
  headline: 'The Hercules Family: The Largest Constellation Group',
  description: 'Guide to the Hercules family — the biggest of all constellation families, with 19 members including Hercules, Lyra, Cygnus, Aquila, Hydra, Ophiuchus and Centaurus. The stars of the Summer Triangle and beyond.',
  datePublished: '2026-07-24',
  dateModified: '2026-07-24',
  author: 'The Astronomy Space',
