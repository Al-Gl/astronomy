  selectJatmoLayer('troposphere');

  // ── Gas Giant Depth Explorer ────────────────────────────────────
  interface DeLayer {
    key: string; name: string; depth: string; temp: string; pressure: string;
    desc: string; fact: string; pctMin: number; pctMax: number;
  }
  const deLayers: DeLayer[] = [
    {
      key: 'clouds', name: 'Cloud Tops', pctMin: 0, pctMax: 12,
      depth: '0 – 50 km', temp: '−145°C', pressure: '0.5 bar',
      desc: "Jupiter's visible face — swirling bands of ammonia ice clouds at the very top of the troposphere. This is all we see from Earth and from spacecraft cameras. Pale zones are rising gas; dark belts are sinking, creating jet streams that have persisted for centuries.",
      fact: "✦ Jupiter's cloud bands move at up to 640 km/h — faster than any wind on Earth.",
    },
    {
      key: 'upper', name: 'Upper Atmosphere', pctMin: 12, pctMax: 30,
      depth: '50 – 1,000 km', temp: '−108°C – 100°C', pressure: '1 – 100 bar',
      desc: "Beneath the clouds, pressure builds rapidly and the atmosphere becomes opaque. Ammonia, ammonium hydrosulfide, and water ice clouds form at different altitudes. The Great Red Spot churns through this layer — a storm wider than Earth extending ~300 km deep.",
      fact: "✦ The Galileo probe survived only 57 minutes after entry in 1995, crushed at the 23-bar level.",
    },
    {
      key: 'deep', name: 'Deep Atmosphere', pctMin: 30, pctMax: 55,
      depth: '1,000 – 10,000 km', temp: '~3,000°C', pressure: '~100,000 bar',
      desc: "Gas gradually transitions to liquid with no sharp boundary — hydrogen here is neither gas nor liquid in any conventional sense. Temperatures climb into the thousands of degrees as pressure exceeds tens of thousands of atmospheres. No spacecraft has ever reached this depth.",
      fact: "✦ There is no surface to 'hit' as you descend — the gas simply becomes an increasingly dense hot fluid.",
    },
    {
      key: 'metallic', name: 'Metallic Hydrogen', pctMin: 55, pctMax: 80,
      depth: '10,000 – 55,000 km', temp: '10,000 – 25,000°C', pressure: '1 – 4 million bar',
      desc: "At roughly 1 million atmospheres, electrons are squeezed free from hydrogen atoms and it becomes electrically conductive — behaving like a liquid metal. This vast churning ocean of metallic hydrogen, spinning with Jupiter's 10-hour rotation, acts as a dynamo generating the largest planetary magnetic field in the Solar System.",
      fact: "✦ Jupiter's magnetic field is 14× stronger than Earth's and extends millions of kilometres into space.",
    },
    {
      key: 'core', name: 'The Core', pctMin: 80, pctMax: 101,
      depth: '55,000 – 70,000 km', temp: '~35,000°C', pressure: '~40 million bar',
      desc: "Jupiter's core is not a sharp solid sphere. Juno spacecraft gravity data reveals a 'fuzzy' dilute core — a partially mixed region of rock, ice, metals, and fluid extending perhaps halfway to the surface. It may be the dissolved remnant of a planetary embryo swallowed during formation.",
      fact: "✦ The core likely contains 3–15 Earth masses of heavy elements, yet may have no distinct solid boundary.",
    },
  ];

  function deLerp(a: number, b: number, t: number): number {
    return Math.round(a + (b - a) * t);
  }
  function deGetDepthKm(pct: number): number {
    if (pct <= 12)  return deLerp(0, 50, pct / 12);
    if (pct <= 30)  return deLerp(50, 1000, (pct - 12) / 18);
    if (pct <= 55)  return deLerp(1000, 10000, (pct - 30) / 25);
    if (pct <= 80)  return deLerp(10000, 55000, (pct - 55) / 25);
    return deLerp(55000, 70000, (pct - 80) / 20);
  }

  function deUpdate(pct: number) {
    const layer = deLayers.find(l => pct >= l.pctMin && pct < l.pctMax) ?? deLayers[deLayers.length - 1];
    const km = deGetDepthKm(pct);

    const marker = document.getElementById('deProbeMarker');
    if (marker) marker.style.top = `calc(${pct}% - 16px)`;

    const nameEl  = document.getElementById('deLayerName');
    const depthEl = document.getElementById('deDepth');
    const tempEl  = document.getElementById('deTemp');
    const pressEl = document.getElementById('dePressure');
    const descEl  = document.getElementById('deDesc');
    const factEl  = document.getElementById('deFact');
    if (nameEl)  nameEl.textContent  = layer.name;
    if (depthEl) depthEl.textContent = `${km.toLocaleString()} km`;
    if (tempEl)  tempEl.textContent  = layer.temp;
    if (pressEl) pressEl.textContent = layer.pressure;
    if (descEl)  descEl.textContent  = layer.desc;
    if (factEl)  factEl.textContent  = layer.fact;

    const explorer = document.getElementById('depthExplorer');
    if (explorer) {
      explorer.className = explorer.className.replace(/\bde-layer-\S+/g, '').trim();
      explorer.classList.add(`de-layer-${layer.key}`);
    }
  }

  const deSlider = document.getElementById('deSlider') as HTMLInputElement | null;
  if (deSlider) {
    deSlider.addEventListener('input', () => deUpdate(+deSlider.value));
    deUpdate(0);
  }

  // ── Gravity Slingshot Simulator ─────────────────────────────────
  const gsCanvas = document.getElementById('gsCanvas') as HTMLCanvasElement | null;
  const gsToggleBtn = document.getElementById('gsToggleBtn') as HTMLButtonElement | null;
  const gsPlayBtn = document.getElementById('gsPlayBtn') as HTMLButtonElement | null;
  const gsResult = document.getElementById('gsResult');
  const gsStateLabel = document.getElementById('gsStateLabel');

  if (gsCanvas) {
    // Planet positions
    const GS_SUN: [number,number] = [65, 165];
    const GS_EARTH: [number,number] = [142, 175];
    const GS_JUPITER: [number,number] = [380, 118];

    // Load card images
    const gsImgSun = new Image();
    const gsImgEarth = new Image();
    const gsImgJupiter = new Image();
    gsImgSun.src = '/images/card_sun.jpg';
    gsImgEarth.src = '/images/card_earth.jpg';
    gsImgJupiter.src = '/images/card_jupiter.jpg';

    let gsJupiterOn = true;
    let gsProgress = 0;
    let gsPlaying = false;
    let gsAnimId = 0;
    let gsPathIndex = 0;
    let gsHasLaunched = false;
    const GS_SPEED = 0.005;

    // 4 asteroid entry directions.
    // Each has: noGrav (single quadratic bezier) and withGrav (two segments).
    // noGrav end is near Earth; withGrav exits away from Earth.
    type GsBez = [[number,number],[number,number],[number,number]];
    interface GsPathDef { noGrav: GsBez; approach: GsBez; exit: GsBez; }
    const gsPaths: GsPathDef[] = [
      { // 1 – upper-right
        noGrav:   [[570, 30],[400, 80],[GS_EARTH[0], GS_EARTH[1]]],
        approach: [[570, 30],[490, 52],[GS_JUPITER[0]+25, GS_JUPITER[1]-20]],
        exit:     [[GS_JUPITER[0]+25, GS_JUPITER[1]-20],[415,205],[420,340]],
      },
      { // 2 – right-middle
        noGrav:   [[570,180],[380,178],[GS_EARTH[0], GS_EARTH[1]]],
        approach: [[570,180],[490,155],[GS_JUPITER[0]+25, GS_JUPITER[1]+10]],
        exit:     [[GS_JUPITER[0]+25, GS_JUPITER[1]+10],[355, 48],[290,-10]],
      },
      { // 3 – lower-right
        noGrav:   [[555,315],[350,255],[GS_EARTH[0], GS_EARTH[1]]],
        approach: [[555,315],[480,235],[GS_JUPITER[0]+28, GS_JUPITER[1]+25]],
        exit:     [[GS_JUPITER[0]+28, GS_JUPITER[1]+25],[435, 72],[565, 38]],
      },
      { // 4 – top-center
        noGrav:   [[320,-10],[248, 72],[GS_EARTH[0], GS_EARTH[1]]],
        approach: [[320,-10],[332, 62],[GS_JUPITER[0]+2, GS_JUPITER[1]-20]],
        exit:     [[GS_JUPITER[0]+2, GS_JUPITER[1]-20],[452,128],[570,162]],
      },
    ];

    function gsBez2(p0: [number,number], p1: [number,number], p2: [number,number], t: number): [number,number] {
      const u = 1 - t;
      return [u*u*p0[0]+2*u*t*p1[0]+t*t*p2[0], u*u*p0[1]+2*u*t*p1[1]+t*t*p2[1]];
    }

    function gsGetPos(t: number): [number,number] {
      const p = gsPaths[gsPathIndex];
      if (!gsJupiterOn) return gsBez2(p.noGrav[0], p.noGrav[1], p.noGrav[2], t);
      return t <= 0.5
        ? gsBez2(p.approach[0], p.approach[1], p.approach[2], t * 2)
        : gsBez2(p.exit[0], p.exit[1], p.exit[2], (t - 0.5) * 2);
    }

    // Draw a circle-clipped image using "cover" scaling to preserve aspect ratio
    function gsDrawPlanetImg(ctx: CanvasRenderingContext2D, img: HTMLImageElement, cx: number, cy: number, r: number) {
      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.clip();
      if (img.complete && img.naturalWidth > 0) {
        const iw = img.naturalWidth;
        const ih = img.naturalHeight;
        const scale = Math.max((r * 2) / iw, (r * 2) / ih);
        const sw = iw * scale;
        const sh = ih * scale;
        ctx.drawImage(img, cx - sw / 2, cy - sh / 2, sw, sh);
      } else {
        ctx.fillStyle = '#888';
        ctx.fill();
      }
      ctx.restore();
    }

    // Draw an irregular rocky asteroid polygon
    function gsDrawAsteroid(ctx: CanvasRenderingContext2D, x: number, y: number, r: number) {
      const offsets = [0.90, 1.15, 0.80, 1.05, 0.88, 1.12, 0.82, 1.00];
      const n = offsets.length;
      ctx.save();
      ctx.fillStyle = '#c4bcb0';
      ctx.strokeStyle = 'rgba(255,255,255,0.25)';
      ctx.lineWidth = 0.8;
      ctx.beginPath();
      for (let i = 0; i < n; i++) {
        const angle = (i / n) * Math.PI * 2 - Math.PI / 2;
        const rad = r * offsets[i];
        const px = x + Math.cos(angle) * rad;
        const py = y + Math.sin(angle) * rad;
        i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
      // small highlight
      ctx.fillStyle = 'rgba(255,255,255,0.22)';
      ctx.beginPath();
      ctx.ellipse(x - r*0.25, y - r*0.3, r*0.35, r*0.2, -0.5, 0, Math.PI*2);
      ctx.fill();
      ctx.restore();
    }

    function gsDraw() {
      const ctx = gsCanvas!.getContext('2d');
      if (!ctx) return;
      const W = 560, H = 330;

      // Background
      const bg = ctx.createRadialGradient(220,165,0, 220,165,310);
      bg.addColorStop(0, 'rgba(16,8,36,1)');
      bg.addColorStop(1, 'rgba(3,1,10,1)');
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, W, H);

      // Stars
      ctx.fillStyle = 'rgba(255,255,255,0.6)';
      [[28,18],[118,38],[198,13],[308,52],[458,28],[528,88],[478,268],[78,288],[248,303],[398,293],[13,178],[165,50],[500,200],[340,290],[70,120]].forEach(([x,y]) => {
        ctx.fillRect(x, y, 1, 1);
      });
      // Slightly brighter stars
      ctx.fillStyle = 'rgba(255,255,255,0.9)';
      [[45,80],[220,260],[490,145],[130,310],[380,18]].forEach(([x,y]) => {
        ctx.fillRect(x, y, 1.5, 1.5);
      });

      // Earth orbit ring
      ctx.strokeStyle = 'rgba(255,255,255,0.06)';
      ctx.setLineDash([4,9]);
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(GS_SUN[0], GS_SUN[1], 90, 0, Math.PI * 2);
      ctx.stroke();
      ctx.setLineDash([]);

      // Jupiter gravity well glow (ON only)
      if (gsJupiterOn) {
        const jglow = ctx.createRadialGradient(GS_JUPITER[0],GS_JUPITER[1],0,GS_JUPITER[0],GS_JUPITER[1],95);
        jglow.addColorStop(0,'rgba(220,145,50,0.14)');
        jglow.addColorStop(1,'rgba(0,0,0,0)');
        ctx.fillStyle = jglow;
        ctx.fillRect(0,0,W,H);
      }

      // Sun glow
      const sgGlow = ctx.createRadialGradient(GS_SUN[0],GS_SUN[1],0,GS_SUN[0],GS_SUN[1],55);
      sgGlow.addColorStop(0,'rgba(255,210,60,0.22)');
      sgGlow.addColorStop(1,'rgba(0,0,0,0)');
      ctx.fillStyle = sgGlow;
      ctx.beginPath(); ctx.arc(GS_SUN[0],GS_SUN[1],55,0,Math.PI*2); ctx.fill();

      // Sun (card image)
      gsDrawPlanetImg(ctx, gsImgSun, GS_SUN[0], GS_SUN[1], 22);

      // Earth (card image)
      gsDrawPlanetImg(ctx, gsImgEarth, GS_EARTH[0], GS_EARTH[1], 12);

      // Jupiter: desaturate overlay when gravity is OFF
      gsDrawPlanetImg(ctx, gsImgJupiter, GS_JUPITER[0], GS_JUPITER[1], 30);
      if (!gsJupiterOn) {
        ctx.save();
        ctx.beginPath(); ctx.arc(GS_JUPITER[0],GS_JUPITER[1],30,0,Math.PI*2); ctx.clip();
        ctx.fillStyle = 'rgba(30,20,10,0.62)';
        ctx.fill();
        ctx.restore();
      }
      // Jupiter border ring (subtle)
      ctx.strokeStyle = gsJupiterOn ? 'rgba(230,170,80,0.35)' : 'rgba(120,100,90,0.2)';
      ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.arc(GS_JUPITER[0],GS_JUPITER[1],30,0,Math.PI*2); ctx.stroke();

      // Asteroid trail
      const trailSteps = 22;
      for (let i = trailSteps; i >= 1; i--) {
        const tVal = Math.max(0, gsProgress - i * GS_SPEED * 1.8);
        const [tx,ty] = gsGetPos(tVal);
        const alpha = (trailSteps - i) / (trailSteps * 3.5);
        ctx.fillStyle = `rgba(200,190,170,${alpha})`;
        ctx.beginPath(); ctx.arc(tx, ty, 2.5, 0, Math.PI*2); ctx.fill();
      }

      // Asteroid
      const [ax,ay] = gsGetPos(gsProgress);
      gsDrawAsteroid(ctx, ax, ay, 7);

      // Labels
      ctx.textAlign = 'center';
      ctx.font = '11px system-ui,sans-serif';
      ctx.fillStyle = 'rgba(255,230,120,0.7)';
      ctx.fillText('Sun', GS_SUN[0], GS_SUN[1] + 38);
      ctx.fillStyle = 'rgba(120,190,255,0.75)';
      ctx.fillText('Earth', GS_EARTH[0], GS_EARTH[1] + 22);
      ctx.fillStyle = gsJupiterOn ? 'rgba(245,185,90,0.85)' : 'rgba(140,115,100,0.6)';
      ctx.fillText('Jupiter', GS_JUPITER[0], GS_JUPITER[1] + 46);
      if (!gsJupiterOn) {
        ctx.fillStyle = 'rgba(220,85,65,0.8)';
        ctx.font = 'bold 10px system-ui,sans-serif';
        ctx.fillText('gravity off', GS_JUPITER[0], GS_JUPITER[1] + 60);
      }

      // Direction indicator (small arrow showing entry direction)
      const dirLabels = ['↙','←','↖','↓'];
      ctx.fillStyle = 'rgba(255,255,255,0.2)';
      ctx.font = '10px system-ui,sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText(`Direction ${gsPathIndex+1}/4 ${dirLabels[gsPathIndex]}`, 8, 320);
    }

    function gsShowResult() {
      if (!gsResult) return;
      if (gsJupiterOn) {
        gsResult.textContent = "✅ Deflected! Jupiter's gravity slung the asteroid safely out of the inner Solar System.";
        gsResult.className = 'gs-result gs-safe';
      } else {
        gsResult.textContent = '☄️ Impact! Without Jupiter, the asteroid reached the inner Solar System.';
        gsResult.className = 'gs-result gs-hit';
      }
      if (gsPlayBtn) gsPlayBtn.textContent = '↺ Next Direction';
    }

    function gsAnimate() {
      if (!gsPlaying) return;
      gsProgress = Math.min(1, gsProgress + GS_SPEED);
      gsDraw();
      if (gsProgress < 1) {
        gsAnimId = requestAnimationFrame(gsAnimate);
      } else {
        gsPlaying = false;
        gsShowResult();
      }
    }

    function gsReset() {
      cancelAnimationFrame(gsAnimId);
      gsProgress = 0;
      gsPlaying = false;
      if (gsResult) { gsResult.textContent = ''; gsResult.className = 'gs-result'; }
      if (gsPlayBtn) gsPlayBtn.textContent = '▶ Launch Asteroid';
      gsDraw();
    }

    gsToggleBtn?.addEventListener('click', () => {
      gsJupiterOn = !gsJupiterOn;
      gsToggleBtn!.setAttribute('aria-pressed', String(gsJupiterOn));
      gsToggleBtn!.className = `gs-toggle-btn ${gsJupiterOn ? 'gs-on' : 'gs-off'}`;
      if (gsStateLabel) gsStateLabel.textContent = gsJupiterOn ? 'ON' : 'OFF';
      gsReset();
    });

    gsPlayBtn?.addEventListener('click', () => {
      // Advance direction on every launch after the first
      if (gsHasLaunched) gsPathIndex = (gsPathIndex + 1) % gsPaths.length;
      gsHasLaunched = true;
      gsReset();
      gsPlaying = true;
      gsAnimId = requestAnimationFrame(gsAnimate);
    });

    // Re-draw when images finish loading
    gsImgSun.onload = gsImgEarth.onload = gsImgJupiter.onload = () => gsDraw();
    gsDraw();
  }
</script>

